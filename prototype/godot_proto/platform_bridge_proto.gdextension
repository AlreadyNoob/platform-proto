[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1

[libraries]
linux.debug.x86_64 = "res://bin/libplatform_bridge_proto.so"
linux.release.x86_64 = "res://bin/libplatform_bridge_proto.so"
android.debug.arm64 = "res://bin/android_arm64/libplatform_bridge_proto.so"
android.release.arm64 = "res://bin/android_arm64/libplatform_bridge_proto.so"
